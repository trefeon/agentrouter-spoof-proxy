# Copy to .env and edit as needed.
# Values below are defaults, uncomment to change.

# Proxy
# LISTEN_PORT=8318
# Listen address. Default is localhost only. For Docker to Docker or remote
# access set to 0.0.0.0 and set PROXY_AUTH_TOKEN below.
# LISTEN_ADDRESS=127.0.0.1
# TARGET_PROTOCOL=https
# TARGET_HOST=agentrouter.org
# TARGET_PORT=443
# REQUEST_TIMEOUT_MS=300000

# Inbound auth, optional, recommended for remote or shared use
# When set, every proxied request must send this token as
# Authorization: Bearer <token> or X-Proxy-Token: <token>. Health and model
# endpoints stay open. Token is compared in constant time and never logged.
# PROXY_AUTH_TOKEN=

# Models
# Static fallback list, comma separated. Used when AR_API_KEY is not set.
# MODELS_CSV=gpt-5.6-sol,claude-opus-5,claude-opus-4-8

# WAF cookie warmup
# WARMUP_INTERVAL_MS=180000

# Retry and circuit breaker
# MAX_RETRIES=2
# RETRY_DELAY_MS=1000
# Retry on 5xx. When false (default), 5xx goes straight to the client.
# Transport errors (timeout, ECONNRESET) are always retried. Set to true to
# restore legacy retry behavior. Warning: retries resend the full body and can
# cause double token billing.
# RETRY_ON_5XX=false

# Model auto-discovery, optional
# Set your AgentRouter API key to enable dynamic listing.
# AR_API_KEY=
# DISCOVERY_INTERVAL_MS=600000

# Timeouts
# Max time to wait for upstream to start responding, ms. Default 300000 (5 min).
# REQUEST_TIMEOUT_MS=300000
# Response timeout: wait for headers. Default 30000 (30s).
# RESPONSE_TIMEOUT_MS=30000
# SSE idle timeout: if no events arrive in this window the stream ends
# (dead or half-open upstream). Default 600000 (10 min).
# SSE_IDLE_TIMEOUT_MS=600000
# SSE chunk timeout: if the stream is quiet this long it is marked slow.
# If the upstream is still open the stream stays alive and the watchdog
# re-arms, so long thinking or tool pauses do not cut the stream.
# Default 30000 (30s).
# SSE_CHUNK_TIMEOUT_MS=30000
# Body upload deadline: if the client stops uploading the request is rejected
# with 408. Default 60000 (60s).
# BODY_UPLOAD_TIMEOUT_MS=60000
# Mark model degraded after slow successful streams. Default 30000 (30s).
# SLOW_RESPONSE_MS=30000
LOG_LEVEL=info

# Prompt injection, optional
# System prompt injected into every request.
# INJECT_SYSTEM_PROMPT=

# Thinking tag stripping
# Strip <think>...</think> from SSE text. When true (default), Claude
# interleaved thinking is stripped before forwarding. Set to false to pass it
# through.
# STRIP_THINKING_TAGS=true
