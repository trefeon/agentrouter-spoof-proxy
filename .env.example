# Copy this file to .env and edit as needed.
# All values shown are the defaults — only uncomment lines you want to change.

# ── Proxy settings ──
# LISTEN_PORT=8318
# Listen address. Secure default is localhost only. For Docker-to-Docker or
# remote access set 0.0.0.0 AND set PROXY_AUTH_TOKEN below.
# LISTEN_ADDRESS=127.0.0.1
# TARGET_PROTOCOL=https
# TARGET_HOST=agentrouter.org
# TARGET_PORT=443
# REQUEST_TIMEOUT_MS=120000

# ── Inbound proxy authentication (optional, recommended for remote/shared) ──
# When set, every proxied request must present this token via
# `Authorization: Bearer <token>` or `X-Proxy-Token: <token>`. Health/model
# endpoints stay open (no secrets). Compared in constant time; never logged.
# PROXY_AUTH_TOKEN=

# ── Models ──
# Static fallback list (comma-separated). Used when AR_API_KEY is not set.
# MODELS_CSV=gpt-5.6-sol,claude-opus-5,claude-opus-4-8

# ── WAF cookie warmup ──
# WARMUP_INTERVAL_MS=180000

# ── Retry / circuit breaker ──
# MAX_RETRIES=2
# RETRY_DELAY_MS=1000
# Retry on 5xx responses. When false (default), 5xx responses are returned to
# the client immediately. Transport errors (timeout, ECONNRESET) are always
# retried regardless of this setting. Set to true to restore legacy retry
# behavior (WARNING: retries re-send the full body, causing double token billing).
# RETRY_ON_5XX=false

# ── Model auto-discovery (optional) ──
# Set your AgentRouter API key to enable dynamic model listing.
# AR_API_KEY=
# DISCOVERY_INTERVAL_MS=600000

# ── Timeouts ──
# Maximum time to wait for upstream to start responding (ms). Default 300000 (5 min).
# REQUEST_TIMEOUT_MS=300000
# Response timeout: wait this long for HTTP response headers. Default 30000 (30s).
# RESPONSE_TIMEOUT_MS=30000
# SSE idle timeout: if no SSE events arrive within this window the stream is
# terminated (dead/half-open upstream connection). Default 600000 (10 min).
# SSE_IDLE_TIMEOUT_MS=600000
# SSE stall watchdog: a stream that goes quiet for this long is reported as slow,
# but as long as the upstream connection is still open the stream is kept alive
# and the watchdog re-arms (long thinking/tool pauses never cut the stream).
# Default 30000 (30s).
# SSE_CHUNK_TIMEOUT_MS=30000
# Body upload deadline: if the client stops uploading, the request is rejected
# with 408. Default 60000 (60s).
# BODY_UPLOAD_TIMEOUT_MS=60000
# Mark model degraded after successful streams slower than this. Default 30000 (30s).
# SLOW_RESPONSE_MS=30000
LOG_LEVEL=info

# ── Prompt injection (optional) ──
# System prompt injected into every request (bypass filtering, jailbreak, etc.)
# INJECT_SYSTEM_PROMPT=

# ── Thinking tag stripping ──
# Strip <think>...</think> tags from SSE response text. When true (default),
# thinking content from Claude's interleaved-thinking mode is stripped before
# forwarding to the client. Set to false to pass thinking content through.
# STRIP_THINKING_TAGS=true
