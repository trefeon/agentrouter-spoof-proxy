{
  "name": "agentrouter-spoof-proxy",
  "version": "1.0.0",
  "description": "Lightweight Node.js reverse proxy that spoofs Claude Code headers to bypass the AgentRouter WAF. Zero runtime dependencies, thin modular entry + 13 focused modules, 120MB Docker image.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node proxy.mjs",
    "test": "node --test tests/unit/*.test.mjs tests/proxy.test.mjs tests/verify-issues.test.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:e2e": "node --test tests/proxy.test.mjs",
    "test:verify": "node --test tests/verify-issues.test.mjs",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/**/*.mjs\" tests/unit/*.test.mjs tests/verify-issues.test.mjs",
    "lint": "oxlint .",
    "check": "node --check proxy.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trefeon/agentrouter-spoof-proxy.git"
  },
  "bugs": {
    "url": "https://github.com/trefeon/agentrouter-spoof-proxy/issues"
  },
  "homepage": "https://github.com/trefeon/agentrouter-spoof-proxy#readme",
  "devDependencies": {
    "oxlint": "^1.76.0"
  }
}
